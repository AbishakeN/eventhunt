# EventSphere Supabase Configuration
# Replace these with your project URL and public anon key from your Supabase dashboard (Project Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional Razorpay Key (Public Key ID for Indian/Global Payment Gateway)
VITE_RAZORPAY_KEY_ID=
